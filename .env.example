# Variáveis de Ambiente - Auto-Rota
# Copie este arquivo para .env.local para desenvolvimento local

# ==============================================
# API Backend (quando implementado)
# ==============================================
# VITE_API_URL=http://localhost:3000/api
# VITE_API_URL=https://api.autorota.com

# ==============================================
# Autenticação (quando implementado)
# ==============================================
# VITE_AUTH_DOMAIN=
# VITE_AUTH_CLIENT_ID=

# ==============================================
# Pagamentos (quando implementado)
# ==============================================
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxx
# VITE_MERCADOPAGO_PUBLIC_KEY=

# ==============================================
# Integração Renach (quando implementado)
# ==============================================
# VITE_RENACH_API_URL=
# VITE_RENACH_CLIENT_ID=

# ==============================================
# Analytics e Monitoramento
# ==============================================
# VITE_GA_TRACKING_ID=
# VITE_SENTRY_DSN=

# ==============================================
# Ambiente
# ==============================================
# VITE_APP_ENV=development
# VITE_APP_VERSION=0.1.0

# ==============================================
# Features Flags (quando necessário)
# ==============================================
# VITE_ENABLE_CHAT=false
# VITE_ENABLE_PAYMENTS=false
# VITE_ENABLE_RENACH_INTEGRATION=false

# ==============================================
# Outros
# ==============================================
# VITE_MAPS_API_KEY=
# VITE_CLOUDINARY_CLOUD_NAME=
